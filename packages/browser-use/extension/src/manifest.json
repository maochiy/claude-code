{
  "manifest_version": 3,
  "name": "CCX",
  "version": "1.0.5",
  "description": "Session-scoped background browser automation bridge for Claude Code Best",
  "key": "",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "sidePanel",
    "nativeMessaging",
    "debugger",
    "alarms",
    "activeTab"
  ],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": { "default_title": "CCX" },
  "side_panel": { "default_path": "sidepanel.html" },
  "minimum_chrome_version": "116"
}
